# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

# Unique across every stack on the same Traefik, or instances fight over a router.
INSTANCE_NAME=

# Drives the Traefik Host() rule and listmonk's root URL.
LISTMONK_DOMAIN=

# Pin a release, never latest.
LISTMONK_VERSION=v6.2.0

DB_PASSWORD=

# Created once at install; changing them later does nothing.
ADMIN_USER=
ADMIN_PASSWORD=

# The sender on every campaign. The address must be verified at the SMTP provider.
FROM_NAME=
FROM_EMAIL=

# SendGrid: smtp.sendgrid.net, user apikey, password a Mail Send key.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------- OPTIONAL

# SMTP_PORT=587
# SMTP_TLS=STARTTLS
# SITE_NAME=Newsletter

# Messages per second. Keep it under the provider's limit.
# SEND_RATE=10

# Turns on bounce and complaint handling; hard bounces and complaints are blocklisted.
# SENDGRID_WEBHOOK_KEY=

# POSTGRES_VERSION=17-alpine
# NODE_VERSION=22-alpine
# MEM_LIMIT_APP=256M
# MEM_LIMIT_DB=512M
# MEM_LIMIT_CONFIGURE=128M
# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
# PLACEMENT_CONSTRAINT=node.role == manager
