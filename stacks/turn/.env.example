# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

# PUBLIC address handed to clients as the relay candidate. Wrong value means
# calls connect and carry no media.
RELAY_IP=

# Every consumer of this server sets the same value. openssl rand -hex 32
TURN_SECRET=

# ---------------------------------------------------------------- OPTIONAL
# All have working defaults. Set only to override.

# ETURNAL_VERSION=1.12.2

# TURN_PORT has to match the TURN_PORT of every consuming stack.
# TURN_PORT=3478

# Set to 0.0.0.0 on a host with IPv6 disabled; binding :: fails there.
# LISTEN_IP=::
# RELAY_IP_V6=

# Every concurrent relay allocation takes one port out of this range.
# RELAY_MIN_PORT=49152
# RELAY_MAX_PORT=65535

# Comma separated, at least one entry. Addresses the SFUs reach us from; a
# range not listed here is refused as a relay peer.
# PEER_WHITELIST=10.0.0.0/8

# LOG_LEVEL=info

# PLACEMENT_CONSTRAINT=node.role == manager
# MEM_LIMIT_TURN=256M
