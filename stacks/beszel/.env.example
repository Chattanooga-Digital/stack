# Paste the REQUIRED block into Portainer's stack environment panel.

# ---------------------------------------------------------------- REQUIRED

# Namespaces this instance's Traefik router and service. Unique across every
# stack on the same Traefik. Lowercase, no spaces.
INSTANCE_NAME=

# Public hostname. Agents also connect to the hub here.
DOMAIN=

# Image tag for hub and agents. They must match.
BESZEL_VERSION=0.20.0

# Blank on the first deploy; the hub generates both. See the README.
AGENT_KEY=
AGENT_TOKEN=

# ---------------------------------------------------------------- OPTIONAL
# All have working defaults. Set only to override.

# Traefik wiring
# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# Scheduling and resources. Applies to the hub only; agents run on every node.
# PLACEMENT_CONSTRAINT=node.role == manager
# MEM_LIMIT_HUB=256M
# MEM_LIMIT_AGENT=64M
