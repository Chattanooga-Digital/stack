# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

# Namespaces this instance's Traefik router and service. Unique across every
# stack on the same Traefik. Lowercase, no spaces.
INSTANCE_NAME=

# Public hostname.
DOMAIN=

# Image tag. Pinned deliberately: an identity server is the last thing that
# should float. 26.7.4 released 2026-09-16.
KEYCLOAK_VERSION=26.7.4

# Postgres password for Keycloak's own database.
DB_PASSWORD=

# Seeds the first admin on an EMPTY database only. Changing it later does
# nothing; use the admin console.
ADMIN_PASSWORD=

# ---------------------------------------------------------------- OPTIONAL
# All have working defaults. Set only to override.

# ADMIN_USER=admin
# DB_NAME=keycloak
# DB_USER=keycloak
# KEYCLOAK_DB_VERSION=18-alpine

# JVM heap. MUST stay well under MEM_LIMIT_KEYCLOAK: left alone the JVM sizes
# itself against the HOST's RAM rather than the container limit, and this node
# already declares more memory than it has.
# JVM_HEAP_MIN=256m
# JVM_HEAP_MAX=1g

# Traefik wiring
# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# Resources
# MEM_LIMIT_KEYCLOAK=1500M
# MEM_LIMIT_DB=512M

# TZ=America/New_York
