# ---------------------------------------------------------------- REQUIRED

# Unique across every stack on the same Traefik, or instances fight over a router.
INSTANCE_NAME=
DOMAIN=

KEYCLOAK_VERSION=26.7.4

DB_PASSWORD=

# First boot only; later changes do nothing. Use the admin console.
ADMIN_PASSWORD=

# ---------------------------------------------------------------- OPTIONAL

# ADMIN_USER=admin
# DB_NAME=keycloak
# DB_USER=keycloak
# KEYCLOAK_DB_VERSION=18-alpine

# Keep the heap well under MEM_LIMIT_KEYCLOAK.
# JVM_HEAP_MIN=256m
# JVM_HEAP_MAX=1g

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# MEM_LIMIT_KEYCLOAK=1500M
# MEM_LIMIT_DB=512M

# TZ=America/New_York
