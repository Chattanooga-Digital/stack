# Nextcloud stack configuration.
#
# Deploying via Portainer: paste the REQUIRED block into the stack's
# environment variables panel. This file is only used for local validation
# (docker compose config) and as the reference list.
#
# Every value below is per-instance. Deploy the same compose file as many
# times as you like, once per Portainer stack, with a different set here.

# ---------------------------------------------------------------- REQUIRED

# Namespaces this instance's Traefik routers, services, and middlewares.
# MUST be unique across every stack on the same Traefik, or the instances
# will silently fight over the same router. Lowercase, no spaces.
INSTANCE_NAME=

# Public hostname. Drives OVERWRITEHOST and every Host() rule.
NC_DOMAIN=

# Space-separated proxy addresses or CIDRs. Scope this to the actual Traefik
# overlay; trusting all private networks lets unrelated tenants spoof forwarded IPs.
NC_TRUSTED_PROXIES=

# Nextcloud refuses a database written by a newer version and will not skip a
# major, so this is never a floating tag.
NEXTCLOUD_VERSION=33.0.6-apache

COLLABORA_VERSION=26.04.2.4.1

# No semantic version tags are published for this image, only commit SHAs plus
# the rolling `latest` and `release`, so a digest is the only honest pin.
WHITEBOARD_VERSION=release@sha256:4bcd45436d60ed485d01551a92536b95c84237efdd46af8b36d666f1f51c6442

NC_DB_PASSWORD=
NC_REDIS_PASSWORD=

# Never "admin". The built-in account is disabled once this one exists.
NC_ADMIN_USER=
NC_ADMIN_PASSWORD=

# Shared with the whiteboard app's jwt_secret_key.
NC_JWT_SECRET=

# ---------------------------------------------------------------- OPTIONAL
# All have working defaults. Set only to override.

# Infrastructure image tags
# Both of these are commented out on purpose, so the compose defaults are what actually
# runs. Those defaults carry a digest. If you uncomment either one, carry the digest with
# it -- a bare `18` or `7-alpine` re-opens the drift these lines exist to close, and it
# will not look broken, because Swarm freezes whatever the tag resolved to on the day the
# service was created.
# POSTGRES_VERSION=18@sha256:7157393f508fd8eb46119937fab39813783fe3e7d4c6316c45c12ce2ea25e61d
# REDIS_VERSION=7-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2

# Database naming
# NC_DB_NAME=nextcloud
# NC_DB_USER=nextcloud

# PHP
# NC_PHP_UPLOAD_LIMIT=10G
# NC_PHP_MEMORY_LIMIT=1024M
# Collabora
# COLLABORA_DICTIONARIES=en_US

# Traefik wiring
# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
# UPLOAD_MAX_BYTES=10737418240

# Scheduling and resources
# PLACEMENT_CONSTRAINT=node.role == manager
# MEM_LIMIT_DB=1G
# MEM_LIMIT_REDIS=256M
# MEM_LIMIT_APP=2G
# MEM_LIMIT_CRON=512M
# MEM_LIMIT_COLLABORA=2G
# MEM_LIMIT_WHITEBOARD=512M
# MEM_LIMIT_TALK=1G

# ---------------------------------------------------------------------------
# Talk (REQUIRED once the talk service is enabled)
# ---------------------------------------------------------------------------
# TALK_HOST is the signaling hostname and needs its own A record pointing at
# this host. TALK_RELAY_IP is the PUBLIC IPv4 of the host, and it is required:
# ingress publishing SNATs through the overlay, so without it the relay
# advertises 10.0.0.x and remote participants get no media.
TALK_HOST=turn.example.com
TALK_RELAY_IP=203.0.113.10

# TALK_PUBLISHED_PORT is the HOST port. Leave at 3478 unless another stack on
# this cluster already publishes it — an ingress publish reserves the port
# cluster-wide, and a second service silently fails to bind. This value is also
# advertised to clients, so it must be the published port, never the container's.
# TALK_PUBLISHED_PORT=3478

# Generate each with: openssl rand -hex 16
# These are environment values because the image reads them from the environment
# only; its /start.sh has no *_FILE form for them. Keep them alphanumeric.
TALK_TURN_SECRET=
TALK_SIGNALING_SECRET=
TALK_INTERNAL_SECRET=

# TALK_IMAGE=strangewill/aio-talk-standalone
# TALK_VERSION=20260428
# TALK_WHITELIST_PEER=10.0.0.0/8
# TALK_LOG_LEVEL=info
