# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

INSTANCE_NAME=
DOMAIN=

ZITADEL_VERSION=v4.17.3

DB_PASSWORD=

# EXACTLY 32 characters, alphanumeric. Zitadel refuses to start on any other
# length, and it cannot be rotated later without re-encrypting every stored
# secret. Generate: openssl rand -hex 16
MASTERKEY=

# Seeds the first admin on an EMPTY database only.
ADMIN_PASSWORD=


# Outbound mail. REQUIRED, because invitations and password resets are how people
# get their accounts, and both of these fail SILENTLY when mail is unconfigured.
# The co-op sends through Resend on its sending subdomain.
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------- OPTIONAL

# Org name, which also forms the admin's login name: <ADMIN_USER>@<ORG_NAME>.<DOMAIN>
# ORG_NAME=zitadel
# ADMIN_USER=admin

# ADMIN_USER=admin
# DB_NAME=zitadel
# DB_USER=zitadel
# ZITADEL_DB_VERSION=17-alpine

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# MEM_LIMIT_ZITADEL=1G
# MEM_LIMIT_DB=512M

# TZ=America/New_York

# SMTP_PORT=587
# SMTP_USE_TLS=true# MAIL_FROM_NAME=Chattanooga.Digital
