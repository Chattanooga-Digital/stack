# ---------------------------------------------------------------- REQUIRED

# Unique across every stack on the same Traefik, or instances fight over a router.
INSTANCE_NAME=
DOMAIN=

ZITADEL_VERSION=v4.17.3

DB_PASSWORD=

# Exactly 32 alphanumeric characters. Cannot be rotated later. openssl rand -hex 16
MASTERKEY=

# First boot only.
ADMIN_PASSWORD=

# Read when the instance is first created. Later changes need the admin API.
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------- OPTIONAL

# Forms the admin login: <ADMIN_USER>@<ORG_NAME>.<DOMAIN>
# ORG_NAME=zitadel
# ADMIN_USER=admin

# DB_NAME=zitadel
# DB_USER=zitadel
# ZITADEL_DB_VERSION=17-alpine

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# MEM_LIMIT_ZITADEL=1G
# MEM_LIMIT_DB=512M

# TZ=America/New_York

# SMTP_PORT=587
# SMTP_USE_TLS=true
# MAIL_FROM_NAME=Chattanooga.Digital
