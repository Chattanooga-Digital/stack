# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

# Must be unique across every stack on the same Traefik, or instances silently
# fight over the same router. Lowercase, no spaces.
INSTANCE_NAME=

# Changing this on a live instance breaks federation. It is not a rename knob.
FUNKWHALE_DOMAIN=

FUNKWHALE_VERSION=2.0.0

# openssl rand -hex 64
DJANGO_SECRET_KEY=

DB_PASSWORD=

# One bucket per instance, on the MinIO behind s3.chattanooga.digital.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# smtp+ssl://user:password@host:port  -- Resend, as the other stacks use.
EMAIL_CONFIG=
DEFAULT_FROM_EMAIL=

# ---------------------------------------------------------------- OPTIONAL
# All have working defaults. Set only to override.

# THE TWO THAT THE MOBILE APP DEPENDS ON.
#
# The Chattanooga.Digital app reads this library with no account and no token.
# Setting either of these the other way empties the Music tab, and nothing else
# reports it -- check with:
#   curl -s https://$FUNKWHALE_DOMAIN/api/v1/instance/nodeinfo/2.0/ \
#     | grep -o '"anonymousCanListen":[a-z]*'
# API_AUTHENTICATION_REQUIRED=false
# ANONYMOUS_CAN_LISTEN=true

# A co-op library, not a public host: members are made by an admin.
# ACCOUNT_REGISTRATION=disabled

# FEDERATION_ENABLED=true
# FEDERATION_DUPLICATE_FETCH_DELAY=86400

# Seconds a signed media URL stays valid. RAISING THIS IS NOT THE FIX for
# playback that stops partway -- see the README. One hour matches what the
# client already re-resolves against.
# S3_URL_EXPIRY=3600

# External PostgreSQL, reached over INTERNAL_NETWORK. Nothing here creates it.
# DB_HOST=postgres_db
# DB_PORT=5432
# DB_USER=funkwhale
# DB_NAME=funkwhale

# REDIS_VERSION=7-alpine
# CELERYD_CONCURRENCY=2
# FUNKWHALE_IMAGE=docker.io/funkwhale/funkwhale

# One gigabyte. Uploads are whole albums.
# UPLOAD_MAX_BYTES=1073741824

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
# INTERNAL_NETWORK=internal_network

# PLACEMENT_CONSTRAINT=node.role == manager
# MEM_LIMIT_API=2G
# MEM_LIMIT_WORKER=2G
# MEM_LIMIT_BEAT=512M
# MEM_LIMIT_REDIS=512M
