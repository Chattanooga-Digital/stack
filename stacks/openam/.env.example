# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

INSTANCE_NAME=
DOMAIN=

OPENAM_VERSION=16.1.3

# Directory Manager password for OpenDJ, which holds BOTH the configuration
# store and the user store. The configurator's properties file calls this same
# value DS_DIRMGRPASSWD.
DIRECTORY_PASSWORD=

# OpenAM's own administrator (amadmin). Set it HERE rather than typing it at the
# configurator: on 2026-09-18 it was typed once and recorded nowhere, and the
# result was an instance nobody - including us - could administer. Alphanumeric
# only; Portainer mangles percent, asterisk and dollar.
OPENAM_ADMIN_PASSWORD=

# The internal amldapuser account the default LDAP module binds as. A separate
# value on purpose: reusing the administrator's password for a service account
# means one leak is two.
OPENAM_AMLDAPUSER_PASSWORD=

# Accounts created on first deploy, with no password. People set their own from
# the mail the system sends, so we never hold it. One record per person,
# separated by ';', fields by ',':   uid,mail,Given,Surname
#   OPENAM_USERS=jdoe,jane@example.org,Jane,Doe;asmith,al@example.org,Al,Smith
# The mail is required: self-service reset sends to it, so an account without
# one could never receive its link. Create-only; an existing account is not touched.
OPENAM_USERS=

# ---------------------------------------------------------------- OPTIONAL

# OPENDJ_VERSION=5.1.2
# CONFIG_BASE_DN=dc=openam,dc=example,dc=org
# DIRECTORY_USER_DN=cn=Directory Manager

# JVM heap, same reasoning as Keycloak: the JVM sizes against the HOST's RAM
# unless told otherwise, and this node is over-committed.
# JVM_HEAP_MIN=512m
# JVM_HEAP_MAX=1g

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# MEM_LIMIT_OPENAM=1500M
# MEM_LIMIT_OPENDJ=512M

# TZ=America/New_York

# Swarm configs are immutable - bump these when the matching script changes.
# OPENDJ_PREP_CONFIG_NAME=openam_djprep_1
# POST_INSTALL_CONFIG_NAME=openam_postinstall_1

# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@get.chattanooga.digital
