# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

INSTANCE_NAME=
DOMAIN=

OPENAM_VERSION=16.1.2

# Directory Manager password for OpenDJ, which holds BOTH the configuration
# store and the user store. The configurator's properties file calls this same
# value DS_DIRMGRPASSWD.
DIRECTORY_PASSWORD=

# ---------------------------------------------------------------- OPTIONAL

# OPENDJ_VERSION=5.1.2
# CONFIG_BASE_DN=dc=openam,dc=example,dc=org
# DIRECTORY_USER_DN=cn=Directory Manager

# JVM heap, same reasoning as Keycloak: the JVM sizes against the HOST's RAM
# unless told otherwise, and this node is over-committed.
# JVM_HEAP_MIN=512m
# JVM_HEAP_MAX=1g

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# MEM_LIMIT_OPENAM=1500M
# MEM_LIMIT_OPENDJ=512M

# TZ=America/New_York
