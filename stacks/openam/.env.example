# ---------------------------------------------------------------- REQUIRED

INSTANCE_NAME=
DOMAIN=

OPENAM_VERSION=16.1.3

DIRECTORY_PASSWORD=

# amadmin
OPENAM_ADMIN_PASSWORD=

# Service account the LDAP auth module binds as. Keep it distinct from the amadmin password.
OPENAM_AMLDAPUSER_PASSWORD=

# Created on first deploy, create-only. Records separated by ';', fields by ',':
# uid,mail,Given,Surname
#   OPENAM_USERS=jdoe,jane@example.org,Jane,Doe;asmith,al@example.org,Al,Smith
# The mail is required: self-service reset sends to it.
OPENAM_USERS=

# ---------------------------------------------------------------- OPTIONAL

# OPENDJ_VERSION=5.1.2
# CONFIG_BASE_DN=dc=openam,dc=example,dc=org
# DIRECTORY_USER_DN=cn=Directory Manager

# Keep the heap well under MEM_LIMIT_OPENAM.
# JVM_HEAP_MIN=512m
# JVM_HEAP_MAX=1g

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# MEM_LIMIT_OPENAM=1500M
# MEM_LIMIT_OPENDJ=512M

# TZ=America/New_York

# Bump when the matching script changes; Swarm configs are immutable.
# OPENDJ_PREP_CONFIG_NAME=openam_djprep_7
# POST_INSTALL_CONFIG_NAME=openam_postinstall_11

# OpenAM's mail service has no STARTTLS, so SMTP_PORT has to be an SSL port.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@get.chattanooga.digital
