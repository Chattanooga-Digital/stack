# Paste the REQUIRED block into Portainer's stack environment panel.

# ---------------------------------------------------------------- REQUIRED

# Namespaces this instance's Traefik router and service. Unique across every
# stack on the same Traefik. Lowercase, no spaces.
INSTANCE_NAME=

# Public hostname. Agents also connect to the server here.
DOMAIN=

PATCHMON_VERSION=2.1.6

# Generate each with: openssl rand -hex 32
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# ---------------------------------------------------------------- OPTIONAL
# All have working defaults. Set only to override.

# TZ=America/New_York

# Traefik wiring
# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# Images
# POSTGRES_VERSION=17-alpine
# REDIS_VERSION=7-alpine

# Scheduling and resources
# PLACEMENT_CONSTRAINT=node.role == manager
# MEM_LIMIT_SERVER=512M
# MEM_LIMIT_DB=512M
# MEM_LIMIT_REDIS=128M
