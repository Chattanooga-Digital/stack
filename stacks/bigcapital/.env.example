# Bigcapital stack configuration.
#
# Deploying via Portainer: paste the REQUIRED block into the stack's
# environment variables panel. This file is only used for local validation
# (docker compose config) and as the reference list.
#
# Every value below is per-instance. Deploy the same compose file as many
# times as you like, once per Portainer stack, with a different set here.

# ---------------------------------------------------------------- REQUIRED

# Namespaces this instance's Traefik routers, services, and middlewares.
# MUST be unique across every stack on the same Traefik, or the instances
# will silently fight over the same router. Lowercase, no spaces.
INSTANCE_NAME=

# Public hostname. Drives BASE_URL and both Traefik Host() rules.
BIGCAPITAL_DOMAIN=

# Image tag for server and webapp. They are a matched pair; the tag must
# exist for both (webapp has skipped tags that server has).
BIGCAPITAL_VERSION=v0.25.25

# MariaDB root password. Also used as DB_PASSWORD, since DB_USER is root.
DB_ROOT_PASSWORD=

# Signs session tokens. Generate: openssl rand -base64 32
APP_JWT_SECRET=

# SMTP
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# S3 object storage. Give each instance its own bucket.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- OPTIONAL
# All have working defaults. Set only to override.

# MAIL_PORT=587
# MAIL_SECURE=false

# S3_REGION=us-east-1

# SIGNUP_DISABLED=false
# SIGNUP_EMAIL_CONFIRMATION=false
# SIGNUP_ALLOWED_DOMAINS=
# SIGNUP_ALLOWED_EMAILS=

# Optional, free key from openexchangerates.org. Blank disables rate lookups.
# OPEN_EXCHANGE_RATE_APP_ID=
# EXCHANGE_RATE_SERVICE=open-exchange-rate

# Infrastructure image tags
# MARIADB_VERSION=10.11
# REDIS_VERSION=7-alpine
# GOTENBERG_VERSION=7

# Database naming. Each stack gets its own MariaDB, so these rarely change.
# SYSTEM_DB_NAME=bigcapital_system
# TENANT_DB_PREFIX=bigcapital_tenant_
# DB_CHARSET=utf8

# Traefik wiring
# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
# UPLOAD_MAX_BYTES=10485760

# Scheduling and resources
# PLACEMENT_CONSTRAINT=node.role == manager
# MEM_LIMIT_DB=512M
# MEM_LIMIT_REDIS=128M
# MEM_LIMIT_GOTENBERG=512M
# MEM_LIMIT_SERVER=1G
# MEM_LIMIT_WEBAPP=128M
# MEM_LIMIT_MIGRATION=512M
