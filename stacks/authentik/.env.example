# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

INSTANCE_NAME=
DOMAIN=

# Image tag, shared by server and worker. They must never diverge.
AUTHENTIK_VERSION=2026.8.2

DB_PASSWORD=

# Signs sessions and tokens. openssl rand -hex 32, then strip non-alphanumerics.
# Changing it later invalidates every existing session.
SECRET_KEY=

# Seeds the first admin on an EMPTY database only.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# Outbound mail. REQUIRED, because invitations and password resets are how people
# get their accounts, and both of these fail SILENTLY when mail is unconfigured.
# The co-op sends through Resend on its sending subdomain.
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------- OPTIONAL

# authentik applies any blueprint YAML it finds under /blueprints. Swarm config
# objects are immutable, so bump this whenever blueprints/force-password-reset.yaml
# changes or the redeploy silently keeps the old content.
# BLUEPRINT_CONFIG_NAME=authentik_force_password_reset_4

# DB_NAME=authentik
# DB_USER=authentik
# AUTHENTIK_DB_VERSION=16-alpine
# AUTHENTIK_REDIS_VERSION=7-alpine

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# Four containers, so the ceilings matter more here than for the others.
# MEM_LIMIT_SERVER=1G
# MEM_LIMIT_WORKER=1G
# MEM_LIMIT_DB=512M
# MEM_LIMIT_REDIS=192M

# TZ=America/New_York

# SMTP_PORT=587
# SMTP_USE_TLS=true
