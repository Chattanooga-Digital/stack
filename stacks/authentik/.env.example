# ---------------------------------------------------------------- REQUIRED

# Unique across every stack on the same Traefik, or instances fight over a router.
INSTANCE_NAME=
DOMAIN=

AUTHENTIK_VERSION=2026.8.2

DB_PASSWORD=

# Changing it invalidates every session and token. openssl rand -hex 32
SECRET_KEY=

# First boot only.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# A placeholder host satisfies the required-variable check and never delivers.
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------- OPTIONAL

# Bump when blueprints/force-password-reset.yaml changes; Swarm configs are immutable.
# BLUEPRINT_CONFIG_NAME=authentik_force_password_reset_5

# DB_NAME=authentik
# DB_USER=authentik
# AUTHENTIK_DB_VERSION=16-alpine
# AUTHENTIK_REDIS_VERSION=7-alpine

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# MEM_LIMIT_SERVER=1G
# MEM_LIMIT_WORKER=1G
# MEM_LIMIT_DB=512M
# MEM_LIMIT_REDIS=192M

# TZ=America/New_York

# SMTP_PORT=587
# SMTP_USE_TLS=true
