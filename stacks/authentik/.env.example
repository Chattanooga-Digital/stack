# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

INSTANCE_NAME=
DOMAIN=

# Image tag, shared by server and worker. They must never diverge.
AUTHENTIK_VERSION=2026.8.2

DB_PASSWORD=

# Signs sessions and tokens. openssl rand -hex 32, then strip non-alphanumerics.
# Changing it later invalidates every existing session.
SECRET_KEY=

# Seeds the first admin on an EMPTY database only.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------- OPTIONAL

# DB_NAME=authentik
# DB_USER=authentik
# AUTHENTIK_DB_VERSION=16-alpine
# AUTHENTIK_REDIS_VERSION=7-alpine

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# Four containers, so the ceilings matter more here than for the others.
# MEM_LIMIT_SERVER=1G
# MEM_LIMIT_WORKER=1G
# MEM_LIMIT_DB=512M
# MEM_LIMIT_REDIS=192M

# TZ=America/New_York
