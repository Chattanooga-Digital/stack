# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.
# The VAPID keypair is the exception.

# ---------------------------------------------------------------- REQUIRED

# Must be unique across every stack on the same Traefik, or instances silently
# fight over the same router. Lowercase, no spaces.
INSTANCE_NAME=

# Changing this on a live instance breaks federation.
MASTODON_DOMAIN=

MASTODON_VERSION=v4.6.4

DB_PASSWORD=

# Not rotatable: changing these invalidates sessions, and the encryption keys
# make existing encrypted columns unreadable. openssl rand -hex 64, and
# bin/rails db:encryption:init for the three ACTIVE_RECORD values.
SECRET_KEY_BASE=
OTP_SECRET=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=

# base64url, so these two are not alphanumeric. Paste exactly.
# bundle exec rake mastodon:webpush:generate_vapid_key
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

SMTP_SERVER=smtp.resend.com
SMTP_LOGIN=resend
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# One bucket per instance.
S3_ENDPOINT=
S3_BUCKET=
# Host media URLs are rewritten to, usually endpoint host + bucket path.
S3_ALIAS_HOST=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- OPTIONAL
# All have working defaults. Set only to override.

# SMTP_PORT=587

# REDIS_VERSION=7-alpine
# ELASTICSEARCH_VERSION=8.19.19

# External PostgreSQL, reached over INTERNAL_NETWORK.
# DB_HOST=postgres_db
# DB_PORT=5432
# DB_USER=mastodon
# DB_NAME=mastodon

# ES_USER and ES_PASS are ignored while es runs with security disabled.
# ES_ENABLED=true
# ES_PRESET=single_node_cluster
# ES_USER=elastic
# ES_PASS=
# ES_JAVA_OPTS=-Xms512m -Xmx512m

# S3_ENABLED=true

# Seconds, default one year.
# IP_RETENTION_PERIOD=31556952
# SESSION_RETENTION_PERIOD=31556952

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
# UPLOAD_MAX_BYTES=10485760
# INTERNAL_NETWORK=internal_network

# PLACEMENT_CONSTRAINT=node.role == manager
# MEM_LIMIT_WEB=2G
# MEM_LIMIT_SIDEKIQ=2G
# MEM_LIMIT_STREAMING=512M
# MEM_LIMIT_ES=2G
# MEM_LIMIT_REDIS=512M
