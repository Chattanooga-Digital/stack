# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

# Must be unique across every stack on the same Traefik, or instances silently
# fight over the same router. Lowercase, no spaces.
INSTANCE_NAME=

# Changing this on a live instance breaks federation and every published event
# URL. Gancio writes it into the config file as baseurl.
GANCIO_DOMAIN=

# 1.x is the stable line. Upstream's docker page recommends `beta`, which is
# 2.0.0-beta.5 today; see README.md before choosing it.
GANCIO_VERSION=1.28.2

DB_PASSWORD=

# ---------------------------------------------------------------- OPTIONAL

# POSTGRES_VERSION=16-alpine
# DB_NAME=gancio
# DB_USER=gancio

# Bump whenever scripts/entrypoint.sh changes. Swarm configs are immutable, so a
# redeploy that reuses the name fails.
# ENTRYPOINT_VERSION=3

# THERE ARE NO MAIL VARIABLES HERE, AND THAT IS DELIBERATE.
# Gancio takes no SMTP environment variables, and its settings are owned by
# Administration > Settings in the admin panel. Set mail there.
#
# Worth knowing rather than rediscovering: a deploy onto empty volumes therefore
# comes up with mail OFF, and gancio needs mail to confirm event submissions and
# to send password resets. Until someone fills the panel in, both fail silently.

# GANCIO_LOG_LEVEL=info
# UPLOAD_MAX_BYTES=20971520

# MEM_LIMIT_GANCIO=1G
# MEM_LIMIT_DB=512M

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
# PLACEMENT_CONSTRAINT=node.role == manager
