# ---------------------------------------------------------------- REQUIRED

# Unique across every stack on the same Traefik, or instances fight over a router.
INSTANCE_NAME=

# Changing it on a live instance breaks federation and published event URLs.
GANCIO_DOMAIN=

GANCIO_VERSION=1.28.2

DB_PASSWORD=

# ---------------------------------------------------------------- OPTIONAL

# POSTGRES_VERSION=16-alpine
# DB_NAME=gancio
# DB_USER=gancio

# Bump when scripts/entrypoint.sh changes; Swarm configs are immutable.
# ENTRYPOINT_VERSION=4

# GANCIO_LOG_LEVEL=info
# UPLOAD_MAX_BYTES=20971520

# MEM_LIMIT_GANCIO=1G
# MEM_LIMIT_DB=512M

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
# PLACEMENT_CONSTRAINT=node.role == manager
