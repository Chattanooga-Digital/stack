# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

# Must be unique across every stack on the same Traefik, or instances silently
# fight over the same router. Lowercase, no spaces.
INSTANCE_NAME=

# Changing this on a live instance breaks federation and every published event
# URL. Gancio writes it into the config file as baseurl.
GANCIO_DOMAIN=

# 1.x is the stable line. Upstream's docker page recommends `beta`, which is
# 2.0.0-beta.5 today; see README.md before choosing it.
GANCIO_VERSION=1.28.2

DB_PASSWORD=

# ---------------------------------------------------------------- OPTIONAL

# POSTGRES_VERSION=16-alpine
# DB_NAME=gancio
# DB_USER=gancio

# Bump whenever scripts/entrypoint.sh changes. Swarm configs are immutable, so a
# redeploy that reuses the name fails.
# ENTRYPOINT_VERSION=2

# Transactional mail. Gancio needs it to confirm event submissions and to send
# password resets; without it those silently do nothing. Leave SMTP_HOST empty
# and the entrypoint writes no mail config at all.
#
# These seed the admin panel's Administration > Settings > SMTP on first boot.
# Once saved there the database value wins, so changing these afterwards has no
# effect until that row is cleared -- the panel is the owner, this is the
# default a rebuild restores.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=
# SMTP_SECURE=            # defaults false, or true when SMTP_PORT is 465
# ADMIN_EMAIL=            # the From address; required when SMTP_HOST is set

# GANCIO_LOG_LEVEL=info
# UPLOAD_MAX_BYTES=20971520

# MEM_LIMIT_GANCIO=1G
# MEM_LIMIT_DB=512M

# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
# PLACEMENT_CONSTRAINT=node.role == manager
